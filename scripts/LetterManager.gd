func get_letter_for_count(count: int) -> Dictionary:
	# 1-7 用对应信件，8+ 都用第 8 封
	var idx = count
	if idx < 1:
		idx = 1
	if idx > LETTERS.size():
		idx = LETTERS.size()
	return LETTERS[idx]


func get_total_variants() -> int:
	return LETTERS.size()